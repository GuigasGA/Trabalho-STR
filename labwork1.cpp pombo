// ============================================================
// TASK GOTO_XZ — mediation task
// Recebe (x,z) por mailbox, despacha para xQueueX/xQueueZ em paralelo,
// espera que ambos terminem.
// ============================================================
void goto_XZ_task(void* pvParameters) {
    Coords c;
    while (TRUE) {
        if (xQueueReceive(mbx_XZ, &c, portMAX_DELAY) == pdTRUE) {
            printf("[XZ] goto (%d,%d)\n", c.x, c.z);

            xSemaphoreTake(xXZBusyMutex, portMAX_DELAY);

            xQueueSend(xQueueX, &c.x, portMAX_DELAY);
            xQueueSend(xQueueZ, &c.z, portMAX_DELAY);

            xSemaphoreTake(sem_X_finished, portMAX_DELAY);
            xSemaphoreTake(sem_Z_finished, portMAX_DELAY);

            printf("[XZ] done (%d,%d)\n", c.x, c.z);
            xSemaphoreGive(xXZBusyMutex);
            xSemaphoreGive(sem_XZ_finished);
        }
    }
}

// ============================================================
// TASK STORE — executa pedidos de armazenamento (FR3)
// ============================================================
void vTaskStore(void* pvParameters) {
    Request req;
    while (1) {
        if (xQueueReceive(xStoreQueue, &req, portMAX_DELAY) == pdTRUE) {
            if (req.type != REQ_STORE) continue;

            int id = req.value;

            if (id < 1 || id > 9) {
                printf("[STORE] ID invalido: %d\n", id);
                continue;
            }

            xSemaphoreTake(xInventoryMutex, portMAX_DELAY);

            if (g_inventory[id].active || g_inventory[id].inTransit) {
                printf("[STORE] ID %d ja armazenado ou em transito. Rejeitado.\n", id);
                xSemaphoreGive(xInventoryMutex);
                continue;
            }

            int cellX, cellZ;
            if (!findEmptyCell(&cellX, &cellZ)) {
                printf("[STORE] Armazem cheio. Rejeitado.\n");
                xSemaphoreGive(xInventoryMutex);
                continue;
            }

            g_inventory[id].inTransit = true;
            g_inventory[id].cellX = cellX;
            g_inventory[id].cellZ = cellZ;
            g_inventory[id].family = getFamily(id);
            xSemaphoreGive(xInventoryMutex);

            printf("[STORE] ID=%d Family=%d Cell=(%d,%d)\n",
                id, getFamily(id), cellX, cellZ);

            g_lightUpperMode = 2;

            // Drenar qualquer sinal fantasma acumulado antes de ordenar a deslocação
            while (xSemaphoreTake(sem_XZ_finished, 0) == pdTRUE);

            Coords c = { cellX, cellZ };
            xQueueSend(mbx_XZ, &c, portMAX_DELAY);
            xSemaphoreTake(sem_XZ_finished, portMAX_DELAY);

            putPartInCell();
            gotoY(2); // Garante Y centrado antes de qualquer próximo ciclo

            ULONGLONG now = GetTickCount64();
            xSemaphoreTake(xInventoryMutex, portMAX_DELAY);
            g_inventory[id].active = true;
            g_inventory[id].inTransit = false;
            g_inventory[id].storageTime = now;
            fifoInsert(id); // Registo na fila FIFO da família
            xSemaphoreGive(xInventoryMutex);

            printf("[STORE] Concluido: ID=%d Time=%llu ms\n", id, now);

            g_lightUpperMode = 0;
        }
    }
}

// ============================================================
// TASK DISPENSE — executa pedidos de dispensação FIFO (FR4)
// ============================================================
void vTaskDispense(void* pvParameters) {
    Request req;
    while (1) {
        if (xQueueReceive(xDispenseQueue, &req, portMAX_DELAY) == pdTRUE) {
            int family = req.value;
            if (family < 1 || family > 3) {
                printf("[DISP] Familia invalida: %d\n", family);
                continue;
            }

            xSemaphoreTake(xInventoryMutex, portMAX_DELAY);

            int id = fifoPop(family);
            if (id == -1) {
                printf("[DISP] Familia %d sem stock (out of stock)\n", family);
                xSemaphoreGive(xInventoryMutex);
                continue;
            }

            g_inventory[id].inTransit = true;
            int cellX = g_inventory[id].cellX;
            int cellZ = g_inventory[id].cellZ;
            ULONGLONG st = g_inventory[id].storageTime;

            xSemaphoreGive(xInventoryMutex);

            printf("[DISP] A retirar Familia=%d -> ID=%d da Celula=(%d,%d)\n",
                family, id, cellX, cellZ);

            g_lightLowerMode = 2; // FR9: Luz inferior pisca

            // 1. Drenar qualquer sinal fantasma acumulado antes do envio
            while (xSemaphoreTake(sem_XZ_finished, 0) == pdTRUE);

            // 2. Vai buscar a peça à prateleira
            Coords c1 = { cellX, cellZ };
            xQueueSend(mbx_XZ, &c1, portMAX_DELAY);
            xSemaphoreTake(sem_XZ_finished, portMAX_DELAY);

            takePartFromCell();
            gotoY(2); // Garante que o garfo recolhe na totalidade antes de viajar

            // 3. Drenar novamente o semáforo antes da viagem para (1,1)
            while (xSemaphoreTake(sem_XZ_finished, 0) == pdTRUE);

            // 4. Transporta e entrega em (1,1)
            Coords c2 = { 1, 1 };
            xQueueSend(mbx_XZ, &c2, portMAX_DELAY);
            xSemaphoreTake(sem_XZ_finished, portMAX_DELAY);

            gotoY(2); // Garante Y centrado após a entrega na célula de saída

            // 5. Atualizar inventário e libertar a célula antiga
            ULONGLONG now = GetTickCount64();

            xSemaphoreTake(xInventoryMutex, portMAX_DELAY);
            g_inventory[id].active = false;
            g_inventory[id].inTransit = false;
            g_inventory[id].cellX = 0; // Desassocia formalmente a coordenada
            g_inventory[id].cellZ = 0;

            if (g_historyCount < 100) {
                g_history[g_historyCount].id = id;
                g_history[g_historyCount].family = family;
                g_history[g_historyCount].dispenseTime = now;
                g_history[g_historyCount].storageDuration = now - st;
                g_historyCount++;
            }
            g_familyCount[family]++;
            g_totalCount++;
            xSemaphoreGive(xInventoryMutex);

            printf("[DISP] Concluido: ID=%d entregue em (1,1). Duracao=%llu ms\n", id, now - st);

            g_lightLowerMode = 0;
        }
    }
}


// ============================================================
// TASK BUTTON REPORTER — timeout da sequência de pulsos
// ============================================================
void vTaskButtonReporter(void* pvParameters) {
    while (1) {
        ULONGLONG now = GetTickCount64();

        uInt8 p1 = readDigitalU8(1);
        bool s1 = getBitValue(p1, 5) ? true : false;
        bool s2 = getBitValue(p1, 6) ? true : false;
        g_bothPressed = (s1 && s2);

        if (g_bothPressed && !emergencyStop) {
            triggerEmergencyStop();
            g_pulseUpper = 0;
            g_pulseLower = 0;
        }

        if (emergencyStop) {
            vTaskDelay(pdMS_TO_TICKS(20));
            continue;
        }

        // Processar Store -> xStoreQueue
        if (g_pulseUpper > 0 && (now - g_lastUpperTime) > PULSE_TIMEOUT_MS) {
            int id = g_pulseUpper;
            g_pulseUpper = 0;

            if (id >= 1 && id <= 9) {
                Request r = { REQ_STORE, id };
                xQueueSend(xStoreQueue, &r, 0);
                printf("[BTN] Store request ID=%d enviado\n", id);
            }
            else {
                printf("[BTN] ID invalido (%d) — ignorado\n", id);
            }
        }

        // Processar Dispense -> xDispenseQueue
        if (g_pulseLower > 0 && (now - g_lastLowerTime) > PULSE_TIMEOUT_MS) {
            int fam = g_pulseLower;
            g_pulseLower = 0;

            if (fam >= 1 && fam <= 3) {
                Request r = { REQ_DISPENSE, fam };
                xQueueSend(xDispenseQueue, &r, 0);
                printf("[BTN] Dispense request family=%d enviado\n", fam);
            }
            else {
                printf("[BTN] Familia invalida (%d) — ignorado\n", fam);
            }
        }

        vTaskDelay(pdMS_TO_TICKS(20));
    }
}
// ============================================================
// TASK LIGHTS
// ============================================================
void vTaskLights(void* pvParameters) {
    bool upperOn = false;
    bool lowerOn = false;
    ULONGLONG lastToggle = 0;

    while (1) {
        ULONGLONG now = GetTickCount64();
        ULONGLONG elapsed = now - lastToggle;

        bool tick = false;
        ULONGLONG period = 1000;

        if (g_lightUpperMode == 3 || g_lightLowerMode == 3) {
            period = 100;
        }
        else if (g_lightUpperMode == 2 || g_lightLowerMode == 2) {
            period = 400;
        }

        if (elapsed >= period) {
            tick = true;
            lastToggle = now;
        }

        switch (g_lightUpperMode) {
        case 0: upperOn = false; break;
        case 1: upperOn = true;  break;
        case 2:
        case 3: if (tick) upperOn = !upperOn; break;
        }

        switch (g_lightLowerMode) {
        case 0: lowerOn = false; break;
        case 1: lowerOn = true;  break;
        case 2:
        case 3: if (tick) lowerOn = !lowerOn; break;
        }

        uInt8 p = readDigitalU8(2);
        setBitValue(&p, 0, upperOn ? 1 : 0);
        setBitValue(&p, 1, lowerOn ? 1 : 0);
        writeDigitalU8(2, p);

        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

// ============================================================
// HOOK DE ARRANQUE
// ============================================================
void myDaemonTaskStartupHook(void) {
    createDigitalInput(0);
    createDigitalInput(1);
    createDigitalOutput(2);

    printf("\nCalibra o kit manualmente e prime ENTER...");
    while (true) {
        if (_kbhit() && _getch() == 13) break;
    }
    printf("\nA iniciar tarefas...\n");

    // Filas de movimento e pedidos
    xQueueX = xQueueCreate(5, sizeof(int));
    xQueueZ = xQueueCreate(5, sizeof(int));
    mbx_XZ = xQueueCreate(5, sizeof(Coords));
    xStoreQueue = xQueueCreate(10, sizeof(Request));       // Fila Store
    xDispenseQueue = xQueueCreate(10, sizeof(Request));    // Fila Dispense
    xXZBusyMutex = xSemaphoreCreateMutex();

    // Semáforos de sincronização
    sem_X_finished = xSemaphoreCreateCounting(10, 0);
    sem_Z_finished = xSemaphoreCreateCounting(10, 0);
    sem_XZ_finished = xSemaphoreCreateCounting(10, 0);
    xInventoryMutex = xSemaphoreCreateMutex();

    // Inicializar inventário
    for (int i = 0; i <= MAX_COMPONENTS; i++) {
        g_inventory[i].id = i;
        g_inventory[i].family = getFamily(i);
        g_inventory[i].cellX = 0;
        g_inventory[i].cellZ = 0;
        g_inventory[i].active = false;
        g_inventory[i].inTransit = false;
        g_inventory[i].storageTime = 0;
    }
    printf("Inventario inicializado.\n");

    // Criar tarefas (passando &hTaskDispense)
    xTaskCreate(vTaskMenu, "Menu", 1000, NULL, 2, NULL);
    xTaskCreate(vTaskHorizontal, "Horizontal", 1000, NULL, 2, &hTaskHorizontal);
    xTaskCreate(vTaskVertical, "Vertical", 1000, NULL, 2, &hTaskVertical);
    xTaskCreate(vTaskButtonReporter, "BtnReporter", 1000, NULL, 2, NULL);
    xTaskCreate(vTaskLights, "Lights", 500, NULL, 1, NULL);
    xTaskCreate(goto_XZ_task, "GOTO XZ Task", 1000, NULL, 3, &hTaskGotoXZ);
    xTaskCreate(vTaskStore, "Store", 1000, NULL, 3, &hTaskStore);
    xTaskCreate(vTaskDispense, "Dispense", 1000, NULL, 3, &hTaskDispense);

    // Anexar ISRs aos pinos dos botões
    attachInterrupt(1, 5, switch1_rising_isr, RISING);
    attachInterrupt(1, 6, switch2_rising_isr, RISING);

    semiCalibration();
    printf("Sistema pronto. Aguardando comandos...\n");
}

// ============================================================
// MAIN
// ============================================================
int main() {
    initialiseHeap();
    vApplicationDaemonTaskStartupHook = &myDaemonTaskStartupHook;
    vTaskStartScheduler();

    while (1);
    return 0;
}
