// ============================================================
// FUNÇÃO DE STOP DE EMERGÊNCIA (FR5)
// ============================================================
void triggerEmergencyStop(void) {
    if (emergencyStop) return;
    emergencyStop = true;

    // 1. Corte físico imediato dos motores
    stopX();
    stopY();
    stopZ();

    // 2. Congelar tarefas de movimento
    if (hTaskStore)      vTaskSuspend(hTaskStore);
    if (hTaskDispense)   vTaskSuspend(hTaskDispense); // Incluído
    if (hTaskGotoXZ)     vTaskSuspend(hTaskGotoXZ);
    if (hTaskHorizontal) vTaskSuspend(hTaskHorizontal);
    if (hTaskVertical)   vTaskSuspend(hTaskVertical);

    // 3. Limpar contadores de pulsos
    g_pulseUpper = 0;
    g_pulseLower = 0;

    printf("\n[EMERGENCY] STOP ATIVADO! Motores e tarefas congelados.\n");
}

// ============================================================
// FUNÇÃO DE RESUME DE EMERGÊNCIA (FR6)
// ============================================================
void triggerResume(void) {
    if (!emergencyStop) return;
    emergencyStop = false;

    g_pulseUpper = 0;
    g_pulseLower = 0;

    // Descongelar tarefas
    if (hTaskVertical)   vTaskResume(hTaskVertical);
    if (hTaskHorizontal) vTaskResume(hTaskHorizontal);
    if (hTaskGotoXZ)     vTaskResume(hTaskGotoXZ);
    if (hTaskDispense)   vTaskResume(hTaskDispense); // Incluído
    if (hTaskStore)      vTaskResume(hTaskStore);

    printf("\n[RESUME] Sistema retomado! A concluir a operacao anterior...\n");
}
//=============================================================
// FUNÇÃO DE RESET DE EMERGÊNCIA (FR5)
//=============================================================
//=============================================================
// FUNÇÃO DE RESET DE EMERGÊNCIA (FR5)
//=============================================================
void triggerReset(void) {
    if (!emergencyStop) return;

    printf("\n[RESET] A cancelar operacao e a reiniciar sistema...\n");

    // 1. Limpar filas de pedidos e mensagens para cancelar o que estava pendente
    if (xStoreQueue)    xQueueReset(xStoreQueue);
    if (xDispenseQueue) xQueueReset(xDispenseQueue);
    if (mbx_XZ)         xQueueReset(mbx_XZ);
    if (xQueueX)        xQueueReset(xQueueX);
    if (xQueueZ)        xQueueReset(xQueueZ);

    // 2. Limpar contagens de pulsos
    g_pulseUpper = 0;
    g_pulseLower = 0;

    // 3. Reverter qualquer peça que estivesse a meio do processo no inventário
    for (int i = 1; i <= MAX_COMPONENTS; i++) {
        if (g_inventory[i].inTransit) {
            g_inventory[i].inTransit = false;
            g_inventory[i].active = false;
            g_inventory[i].cellX = 0;
            g_inventory[i].cellZ = 0;
            printf("[RESET] Peça ID=%d cancelada do transito.\n", i);
        }
    }

    // 4. Descongelar as tarefas para voltarem ao ciclo de espera
    if (hTaskVertical)   vTaskResume(hTaskVertical);
    if (hTaskHorizontal) vTaskResume(hTaskHorizontal);
    if (hTaskGotoXZ)     vTaskResume(hTaskGotoXZ);
    if (hTaskDispense)   vTaskResume(hTaskDispense);
    if (hTaskStore)      vTaskResume(hTaskStore);

    // 5. Repor o sistema em modo normal
    emergencyStop = false;
    g_lightUpperMode = 0;
    g_lightLowerMode = 0;

    printf("[RESET] Sistema reiniciado e pronto para novos pedidos!\n");
}

// ============================================================
// ISRs DOS BOTÕES
// ============================================================
void switch1_rising_isr(ULONGLONG lastTime) {
    ULONGLONG time = GetTickCount64();
    uInt8 p1 = readDigitalU8(1);
    bool s2 = getBitValue(p1, 6) ? true : false;

    // Se ambos estiverem premidos, é paragem de emergência
    if (s2) {
        triggerEmergencyStop();
        return;
    }

    // Se o sistema estiver em STOP, o Switch 1 serve para dar RESUME (FR6)
    if (emergencyStop) {
        triggerResume();
        return;
    }

    // Funcionamento Normal: contar pulsos para STORE (FR3)
    g_pulseUpper++;
    g_lastUpperTime = time;
}

void switch2_rising_isr(ULONGLONG lastTime) {
    ULONGLONG time = GetTickCount64();
    uInt8 p1 = readDigitalU8(1);
    bool s1 = getBitValue(p1, 5) ? true : false;

    // Se ambos estiverem premidos, é paragem de emergência
    if (s1) {
        triggerEmergencyStop();
        return;
    }

    // Se estiver em STOP, Switch 2 executa o RESET (FR7)
    if (emergencyStop) {
        triggerReset();
        return;
    }

    // Contar pulsos para DISPENSE (apenas fora de emergência)
    g_pulseLower++;
    g_lastLowerTime = time;
}


