    int target;
    while (1) {
        if (xQueueReceive(xQueueX, &target, portMAX_DELAY) == pdTRUE) {
            if (getYPos() != 2) {
                printf("[H] Y nao esta em 2, ignorado X=%d\n", target);
                xSemaphoreGive(sem_X_finished);
