// ============================================================
// FIFO POR FAMÍLIA (FR4)
// ============================================================
void fifoInsert(int id) {
    int fam = g_inventory[id].family;
    if (g_fifoCount[fam] >= MAX_COMPONENTS) return;
    g_fifo[fam][g_fifoCount[fam]++] = id;
}

int fifoPop(int family) {
    if (family < 1 || family > 3) return -1;
    if (g_fifoCount[family] == 0) return -1;
    int id = g_fifo[family][0];
    for (int i = 0; i < g_fifoCount[family] - 1; i++)
        g_fifo[family][i] = g_fifo[family][i + 1];
    g_fifoCount[family]--;
    return id;
}

