#pragma once

#include <stdio.h>
#include <windows.h>

extern "C" {
#include <interface.h>
#include <FreeRTOS.h>
#include <task.h>
#include <semphr.h>
}

// Flag de abort (definida no ficheiro principal)
extern volatile bool resetInProgress;

// Bits
int  getBitValue(uInt8 value, uInt8 bit_n);
void setBitValue(uInt8* variable, int n_bit, int new_value_bit);

// Tem de ser chamada uma vez antes de qualquer movimento (cria o mutex da porta 2)
void initMotionLayer();

// Escrita atomica de bits na porta 2: bits em 'mask' passam a ter o valor de 'value'
void setPort2Bits(uInt8 mask, uInt8 value);

// X
void moveXLeft();
void moveXRight();
void stopX();
int  getXPos();
bool gotoX(int x);          // true = chegou, false = abortado / timeout

// Y
void moveYInside();
void moveYOutside();
void stopY();
int  getYPos();
bool gotoY(int y);

// Z
void moveZUp();
void moveZDown();
void stopZ();
int  getZPos();
bool gotoZ(int z);
bool gotoZUp();
bool gotoZDown();

// Sequencias compostas
bool putPartInCell();
bool takePartFromCell();
