void vTaskLimitGuard(void* pvParameters) {
    while (1) {
        enforceAxisLimits();
        vTaskDelay(pdMS_TO_TICKS(5));
    }
}

static void spawn(TaskFunction_t fn, const char* name, uint16_t stack,
    UBaseType_t prio, TaskHandle_t* handle) {
    if (xTaskCreate(fn, name, stack, NULL, prio, handle) != pdPASS)
        printf("[ERRO] Falha a criar a task %s (heap insuficiente?)\n", name);
}

void myDaemonTaskStartupHook(void) {
    createDigitalInput(0);
    createDigitalInput(1);
    createDigitalOutput(2);

    printf("\nCalibra o kit manualmente e prime ENTER...");
    while (true) {
        if (_kbhit() && _getch() == 13) break;
    }
    printf("\nA iniciar tarefas...\n");

    initMotionLayer();

    // Filas
    xQueueX = xQueueCreate(5, sizeof(int));
    xQueueZ = xQueueCreate(5, sizeof(int));
    mbx_XZ = xQueueCreate(5, sizeof(Coords));
    xRequestQueue = xQueueCreate(10, sizeof(Request));

    // Mutex e semaforos
    xInventoryMutex = xSemaphoreCreateMutex();
    sem_X_finished = xSemaphoreCreateCounting(10, 0);
    sem_Z_finished = xSemaphoreCreateCounting(10, 0);
    sem_XZ_finished = xSemaphoreCreateCounting(10, 0);

    if (!xQueueX || !xQueueZ || !mbx_XZ || !xRequestQueue ||
        !xInventoryMutex || !sem_X_finished || !sem_Z_finished || !sem_XZ_finished) {
        printf("[ERRO] Falha a criar filas/semaforos (heap insuficiente?)\n");
        return;
    }

    // Inventario
    for (int i = 0; i <= MAX_COMPONENTS; i++) {
        g_inventory[i].id = i;
        g_inventory[i].family = getFamily(i);
        g_inventory[i].cellX = 0;
        g_inventory[i].cellZ = 0;
        g_inventory[i].active = false;
        g_inventory[i].inTransit = false;
        g_inventory[i].onArm = false;
        g_inventory[i].storageTime = 0;
    }
    printf("Inventario inicializado.\n");

    // Tarefas (handles guardados para STOP/RESUME/RESET)
    spawn(vTaskMenu, "Menu", 1000, 2, NULL);
    spawn(vTaskHorizontal, "Horizontal", 1000, 2, &hTaskHorizontal);
    spawn(vTaskVertical, "Vertical", 1000, 2, &hTaskVertical);
    spawn(vTaskButtonReporter, "BtnReporter", 1000, 2, NULL);
    spawn(vTaskLights, "Lights", 500, 1, NULL);
    spawn(goto_XZ_task, "GOTO XZ Task", 1000, 3, &hTaskGotoXZ);
    spawn(vTaskOps, "Ops", 1000, 3, &hTaskOps);
    spawn(vTaskLimitGuard, "LimitGuard", 400, 3, NULL);
    spawn(vTaskStartupCalibration, "StartupCalib", 1000, 4, NULL);

    // ISRs
    attachInterrupt(1, 5, switch1_rising_isr, RISING);
    attachInterrupt(1, 6, switch2_rising_isr, RISING);

    printf("Sistema pronto.\n");
}

