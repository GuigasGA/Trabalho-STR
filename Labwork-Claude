// Movimentos manuais so com o sistema livre
static bool manualAllowed() {
    if (g_stopped) { printf("[MENU] Sistema em STOP.\n"); return false; }
    if (g_busyOps) { printf("[MENU] Operacao em curso.\n"); return false; }
    return true;
}

static void showInventory() {
    if (!invLock(pdMS_TO_TICKS(1000))) { printf("[MENU] Inventario ocupado.\n"); return; }
    printf("\n--- FR11: Inventario ---\n");
    printf("%-3s %-6s %-8s %-14s %-12s\n", "ID", "Fam", "Cell", "StorageTime", "Elapsed");
    bool any = false;
    ULONGLONG now = GetTickCount64();
    for (int id = 1; id <= MAX_COMPONENTS; id++) {
        if (!g_inventory[id].active) continue;
        any = true;
        char ts[32], el[32];
        formatTime(g_inventory[id].storageTime, ts, sizeof(ts));
        formatTime(now - g_inventory[id].storageTime, el, sizeof(el));
        printf("%-3d %-6d (%d,%d)   %-14s %-12s\n",
            id, g_inventory[id].family,
            g_inventory[id].cellX, g_inventory[id].cellZ, ts, el);
    }
    if (!any) printf("(vazio)\n");
    invUnlock();
}

static void showFamily(int fam) {
    if (fam < 1 || fam > 3) { printf("Familia invalida\n"); return; }
    if (!invLock(pdMS_TO_TICKS(1000))) { printf("[MENU] Inventario ocupado.\n"); return; }
    printf("\n--- FR12: Familia %d ---\n", fam);
    printf("Disponiveis: %d\n", g_fifoCount[fam]);
    if (g_fifoCount[fam] > 0) {
        int nid = g_fifo[fam][0];
        char ts[32];
        formatTime(g_inventory[nid].storageTime, ts, sizeof(ts));
        printf("Proximo FIFO: ID=%d Cell=(%d,%d) StorageTime=%s\n",
            nid, g_inventory[nid].cellX, g_inventory[nid].cellZ, ts);
    }
    else {
        printf("Out of stock.\n");
    }
    invUnlock();
}

static void showCell(int qx, int qz) {
    if (qx < 1 || qx > 3 || qz < 1 || qz > 3) { printf("Celula invalida\n"); return; }
    if (!invLock(pdMS_TO_TICKS(1000))) { printf("[MENU] Inventario ocupado.\n"); return; }
    printf("\n--- FR13: Celula (%d,%d) ---\n", qx, qz);
    int id = findComponentInCell(qx, qz);
    if (id == -1) {
        printf("Celula vazia.\n");
    }
    else {
        char ts[32], el[32];
        ULONGLONG now = GetTickCount64();
        formatTime(g_inventory[id].storageTime, ts, sizeof(ts));
        formatTime(now - g_inventory[id].storageTime, el, sizeof(el));
        printf("ID=%d Family=%d StorageTime=%s Elapsed=%s%s\n",
            id, g_inventory[id].family, ts, el,
            g_inventory[id].inTransit ? " (em transito)" : "");
    }
    invUnlock();
}

static void showHistory() {
    if (!invLock(pdMS_TO_TICKS(1000))) { printf("[MENU] Inventario ocupado.\n"); return; }
    printf("\n--- FR14: Historico ---\n");
    if (g_historyCount == 0) {
        printf("(vazio)\n");
    }
    else {
        printf("%-3s %-4s %-6s %-14s %-12s\n", "#", "ID", "Fam", "DispenseTime", "Duracao");
        int start = (g_historyCount > HISTORY_SIZE) ? (g_historyCount - HISTORY_SIZE) : 0;
        int count = (g_historyCount > HISTORY_SIZE) ? HISTORY_SIZE : g_historyCount;
        for (int i = 0; i < count; i++) {
            int idx = (start + i) % HISTORY_SIZE;
            char dt[32], du[32];
            formatTime(g_history[idx].dispenseTime, dt, sizeof(dt));
            formatTime(g_history[idx].storageDuration, du, sizeof(du));
            printf("%-3d %-4d %-6d %-14s %-12s\n",
                i + 1, g_history[idx].id, g_history[idx].family, dt, du);
        }
    }
    invUnlock();
}

static void showCounters() {
    if (!invLock(pdMS_TO_TICKS(1000))) { printf("[MENU] Inventario ocupado.\n"); return; }
    printf("\n--- FR15: Contadores ---\n");
    for (int fam = 1; fam <= 3; fam++)
        printf("Familia %d: %d servicos\n", fam, g_familyCount[fam]);
    printf("Total: %d\n", g_totalCount);
    invUnlock();
}

