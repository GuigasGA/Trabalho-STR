// --- desenho do menu (largura interior fixa: 64 colunas) ---
static void menuRule() {
    printf("+");
    for (int i = 0; i < 64; i++) putchar('-');
    printf("+\n");
}

static void menuLine(const char* s) {
    printf("| %-62s |\n", s);
}

static void menuTitle(const char* s) {
    int len = 0;
    while (s[len]) len++;
    int left = (62 - len) / 2;
    int right = 62 - len - left;
    printf("| %*s%s%*s |\n", left, "", s, right, "");
}

static void printMenu() {
    const char* estado =
        g_stopped ? "Estado: STOP (usa os botoes para RESUME / RESET)" :
        g_busyOps ? "Estado: operacao em curso" :
        "Estado: livre";

    printf("\n");
    menuRule();
    menuTitle("ARMAZEM AUTOMATICO - MENU");
    menuRule();
    menuLine(estado);
    menuRule();
    menuLine("MOVIMENTOS AUTOMATICOS");
    menuLine("  4 / 5 / 6   Y para a posicao 1 / 2 / 3");
    menuLine("  g           Ir a uma celula (pede X e Z)");
    menuLine("  u / z       Z para cima / para baixo");
    menuLine("  p / t       Guardar (put) / retirar (take) peca");
    menuLine("  c           Calibrar (Y=2, X=1, Z=1)");
    menuRule();
    menuLine("MOVIMENTOS MANUAIS (continuos ate premir s)");
    menuLine("  a / d       X esquerda / direita");
    menuLine("  q / e       Y para dentro / para fora");
    menuLine("  w / x       Z para cima / para baixo");
    menuLine("  s           Parar todos os motores");
    menuRule();
    menuLine("LUZES (cada toque: OFF > ON > lenta > rapida)");
    menuLine("  l           Luz superior (upper)");
    menuLine("  k           Luz inferior (lower)");
    menuRule();
    menuLine("INFORMACAO");
    menuLine("  i           Inventario completo");
    menuLine("  f           Estado de uma familia (pede 1-3)");
    menuLine("  v           Conteudo de uma celula (pede X e Z)");
    menuLine("  h           Historico de dispensas");
    menuLine("  n           Contadores de servicos");
    menuRule();
    menuLine("SISTEMA");
    menuLine("  m  ou  ?    Mostrar este menu outra vez");
    menuLine("  ESC         Sair");
    menuRule();
    printf("\n");
}

void vTaskMenu(void* pvParameters) {
    int tecla = 0;
    printMenu();

    while (tecla != 27) {
        if (_kbhit()) {
            tecla = _getch();

            if (tecla == 's') { stopX(); stopY(); stopZ(); }
            else if (tecla == 'm' || tecla == '?') { printMenu(); }

            // --- movimentos manuais (so com o sistema livre) ---
            else if (tecla == 'q') { if (manualAllowed()) moveYInside(); }
            else if (tecla == 'e') { if (manualAllowed()) moveYOutside(); }
            else if (tecla == 'w') { if (manualAllowed()) moveZUp(); }
            else if (tecla == 'x') { if (manualAllowed()) moveZDown(); }
            else if (tecla == 'a') { if (manualAllowed()) moveXLeft(); }
            else if (tecla == 'd') { if (manualAllowed()) moveXRight(); }

            else if (tecla == '4') { if (manualAllowed()) gotoY(1); }
            else if (tecla == '5') { if (manualAllowed()) gotoY(2); }
            else if (tecla == '6') { if (manualAllowed()) gotoY(3); }

            else if (tecla == 'u') { if (manualAllowed()) gotoZUp(); }
            else if (tecla == 'z') { if (manualAllowed()) gotoZDown(); }
            else if (tecla == 'p') { if (manualAllowed()) putPartInCell(); }
            else if (tecla == 't') { if (manualAllowed()) takePartFromCell(); }
            else if (tecla == 'c') { if (manualAllowed()) semiCalibration(); }

            else if (tecla == 'g') {
                printf("X (1-3): ");
                int x = readDigit();
                printf("Z (1-3): ");
                int z = readDigit();

                if (x >= 1 && x <= 3 && z >= 1 && z <= 3) {
                    if (manualAllowed()) {
                        Coords c = { x, z, false };   // sem notify: ninguem espera por este "done"
                        xQueueSend(mbx_XZ, &c, 0);
                    }
                }
                else {
                    printf("Coordenadas invalidas\n");
                }
            }

            // --- luzes ---
            else if (tecla == 'l') {
                g_lightUpperMode = (g_lightUpperMode + 1) % 4;
                printf("Luz upper mode = %d\n", g_lightUpperMode);
            }
            else if (tecla == 'k') {
                g_lightLowerMode = (g_lightLowerMode + 1) % 4;
                printf("Luz lower mode = %d\n", g_lightLowerMode);
            }

            // --- informacao ---
            else if (tecla == 'i') { showInventory(); }
            else if (tecla == 'f') {
                printf("Familia (1-3): ");
                showFamily(readDigit());
            }
            else if (tecla == 'v') {
                printf("X (1-3): ");
                int qx = readDigit();
                printf("Z (1-3): ");
                int qz = readDigit();
                showCell(qx, qz);
            }
            else if (tecla == 'h') { showHistory(); }
            else if (tecla == 'n') { showCounters(); }
        }
        vTaskDelay(pdMS_TO_TICKS(20));
    }
    closeChannels();
    exit(0);
}

// ============================================================
// TASK HORIZONTAL
// ============================================================
void vTaskHorizontal(void* pvParameters) {
    int target;
    while (1) {
        if (xQueueReceive(xQueueX, &target, portMAX_DELAY) == pdTRUE) {
            g_busyH = true;
            bool ok = true;
            if (getYPos() != 2) {
                printf("[H] Y!=2, a forcar Y=2 antes de mover X\n");
                ok = gotoY(2);
            }
            if (ok) {
                printf("[H] gotoX(%d)\n", target);
                gotoX(target);
            }
            g_busyH = false;
            xSemaphoreGive(sem_X_finished);
        }
    }
}

// ============================================================
// TASK VERTICAL
// ============================================================
void vTaskVertical(void* pvParameters) {
    int target;
    while (1) {
        if (xQueueReceive(xQueueZ, &target, portMAX_DELAY) == pdTRUE) {
            g_busyV = true;
            bool ok = true;
            if (getYPos() != 2) {
                printf("[V] Y!=2, a forcar Y=2 antes de mover Z\n");
                ok = gotoY(2);
            }
            if (ok) {
                printf("[V] gotoZ(%d)\n", target);
                gotoZ(target);
            }
            g_busyV = false;
            xSemaphoreGive(sem_Z_finished);
        }
    }
}

// ============================================================
// TASK GOTO_XZ (mediacao)
// ============================================================
void goto_XZ_task(void* pvParameters) {
    Coords c;
    while (1) {
        if (xQueueReceive(mbx_XZ, &c, portMAX_DELAY) == pdTRUE) {
            g_busyXZ = true;
            printf("[XZ] goto (%d,%d)\n", c.x, c.z);

            xQueueSend(xQueueX, &c.x, portMAX_DELAY);
            xQueueSend(xQueueZ, &c.z, portMAX_DELAY);

            xSemaphoreTake(sem_X_finished, portMAX_DELAY);
            xSemaphoreTake(sem_Z_finished, portMAX_DELAY);

            printf("[XZ] done (%d,%d)\n", c.x, c.z);
            g_busyXZ = false;
            if (c.notify) xSemaphoreGive(sem_XZ_finished);
        }
    }
}

// Move o carro para (x,z) e espera. Devolve true so se REALMENTE chegou.
static bool moveXZ(int x, int z) {
    Coords c = { x, z, true };
    if (xQueueSend(mbx_XZ, &c, portMAX_DELAY) != pdTRUE) return false;
    xSemaphoreTake(sem_XZ_finished, portMAX_DELAY);
    if (resetInProgress) return false;
    return (getXPos() == x && getZPos() == z && getYPos() == 2);
}

// ============================================================
// STORE (FR3)
// ============================================================
static void doStore(int id) {
    if (id < 1 || id > 9) {
        printf("[STORE] ID invalido: %d\n", id);
        return;
    }

    invLock(portMAX_DELAY);
    if (g_inventory[id].active || g_inventory[id].inTransit) {
        printf("[STORE] ID %d ja ocupado. Rejeitado.\n", id);
        invUnlock();
        return;
    }
    int cellX, cellZ;
    if (!findEmptyCell(&cellX, &cellZ)) {
        printf("[STORE] Armazem cheio.\n");
        invUnlock();
        return;
    }
    g_inventory[id].inTransit = true;
    g_inventory[id].onArm = false;
    g_inventory[id].cellX = cellX;
    g_inventory[id].cellZ = cellZ;
    g_inventory[id].family = getFamily(id);
    invUnlock();

    printf("[STORE] ID=%d Family=%d Cell=(%d,%d)\n", id, getFamily(id), cellX, cellZ);
    g_lightUpperMode = 2;

    bool ok = moveXZ(cellX, cellZ) && putPartInCell();

    if (!ok) {
        printf("[STORE] FALHOU para ID=%d\n", id);
        invLock(portMAX_DELAY);
        rollbackTransitLocked(id);
        invUnlock();
        g_lightUpperMode = 0;
        return;
    }

    ULONGLONG now = GetTickCount64();
    invLock(portMAX_DELAY);
    g_inventory[id].active = true;
    g_inventory[id].inTransit = false;
    g_inventory[id].storageTime = now;
    fifoInsert(id);
    invUnlock();

    printf("[STORE] Concluido: ID=%d Time=%llu ms\n", id, now);
    g_lightUpperMode = 0;
}

// ============================================================
// DISPENSE (FR4)
// ============================================================
static void doDispense(int family) {
    if (family < 1 || family > 3) {
        printf("[DISP] Familia invalida: %d\n", family);
        return;
    }

    invLock(portMAX_DELAY);
    int id = fifoPop(family);
    if (id == -1) {
        printf("[DISP] Familia %d sem stock\n", family);
        invUnlock();
        return;
    }
    g_inventory[id].inTransit = true;
    g_inventory[id].onArm = false;
    int cellX = g_inventory[id].cellX;
    int cellZ = g_inventory[id].cellZ;
    ULONGLONG st = g_inventory[id].storageTime;
    invUnlock();

    printf("[DISP] Familia=%d -> ID=%d Cell=(%d,%d)\n", family, id, cellX, cellZ);
    g_lightLowerMode = 2;

    // 1) ir a celula e retirar a peca
    bool ok = moveXZ(cellX, cellZ) && takePartFromCell();
    if (!ok) {
        printf("[DISP] FALHOU (antes de retirar) para ID=%d\n", id);
        invLock(portMAX_DELAY);
        rollbackTransitLocked(id);
        invUnlock();
        g_lightLowerMode = 0;
        return;
    }

    invLock(portMAX_DELAY);
    g_inventory[id].onArm = true;       // a partir daqui a peca ja nao esta na celula
    invUnlock();

    // 2) levar a peca ao ponto de entrega (1,1)
    ok = moveXZ(1, 1);
    if (!ok) {
        printf("[DISP] FALHOU (a entregar) para ID=%d\n", id);
        invLock(portMAX_DELAY);
        rollbackTransitLocked(id);
        invUnlock();
        g_lightLowerMode = 0;
        return;
    }

    ULONGLONG now = GetTickCount64();
    invLock(portMAX_DELAY);
    g_inventory[id].active = false;
    g_inventory[id].inTransit = false;
    g_inventory[id].onArm = false;
    g_inventory[id].cellX = 0;
    g_inventory[id].cellZ = 0;

    // buffer circular — mantem sempre os ultimos HISTORY_SIZE
    int slot = g_historyCount % HISTORY_SIZE;
    g_history[slot].id = id;
    g_history[slot].family = family;
    g_history[slot].dispenseTime = now;
    g_history[slot].storageDuration = now - st;
    g_historyCount++;
    g_familyCount[family]++;
    g_totalCount++;
    invUnlock();

    printf("[DISP] Concluido: ID=%d Duracao=%llu ms\n", id, now - st);
    g_lightLowerMode = 0;
}

// ============================================================
// TASK OPERACOES — processa um pedido de cada vez
// ============================================================
void vTaskOps(void* pvParameters) {
    Request req;
    while (1) {
        if (xQueueReceive(xRequestQueue, &req, portMAX_DELAY) == pdTRUE) {
            if (resetInProgress) continue;   // descartar pedidos durante o reset

            g_busyOps = true;
            if (req.type == REQ_STORE) doStore(req.value);
            else                       doDispense(req.value);
            g_busyOps = false;
        }
    }
}

// ============================================================
// TASK BUTTON REPORTER — pulsos + STOP/RESUME/RESET
// ============================================================
static void clearPulses() {
    taskENTER_CRITICAL();
    g_pulseUpper = 0;
    g_pulseLower = 0;
    taskEXIT_CRITICAL();
}

void vTaskButtonReporter(void* pvParameters) {
    bool lastS1 = false;
    bool lastS2 = false;

    while (1) {
        uInt8 p1 = readDigitalU8(1);
        bool s1 = getBitValue(p1, 5) ? true : false;
        bool s2 = getBitValue(p1, 6) ? true : false;
        bool s1_rising = (s1 && !lastS1);
        bool s2_rising = (s2 && !lastS2);

        if (!g_stopped) {
            // FR5: ambos premidos -> STOP
            if (s1 && s2) {
                triggerEmergencyStop();
                clearPulses();
            }
            else {
                // Leitura/limpeza atomica dos pulsos (a ISR pode disparar a qualquer momento)
                int pu = 0, pl = 0;
                taskENTER_CRITICAL();
                ULONGLONG now = GetTickCount64();
                if (g_pulseUpper > 0 && (now - g_lastUpperTime) > PULSE_TIMEOUT_MS) {
                    pu = g_pulseUpper;
                    g_pulseUpper = 0;
                }
                if (g_pulseLower > 0 && (now - g_lastLowerTime) > PULSE_TIMEOUT_MS) {
                    pl = g_pulseLower;
                    g_pulseLower = 0;
                }
                taskEXIT_CRITICAL();

                if (pu > 0) {
                    if (pu >= 1 && pu <= 9) {
                        Request r = { REQ_STORE, pu };
                        xQueueSend(xRequestQueue, &r, 0);
                        printf("[BTN] Store request ID=%d\n", pu);
                    }
                    else {
                        printf("[BTN] ID invalido (%d)\n", pu);
                    }
                }
                if (pl > 0) {
                    if (pl >= 1 && pl <= 3) {
                        Request r = { REQ_DISPENSE, pl };
                        xQueueSend(xRequestQueue, &r, 0);
                        printf("[BTN] Dispense request family=%d\n", pl);
                    }
                    else {
                        printf("[BTN] Familia invalida (%d)\n", pl);
                    }
                }
            }
        }
        else {
            // FR6: so upper (rising) -> RESUME
            if (s1_rising && !s2) {
                triggerResume();
                clearPulses();
            }
            // FR7: so lower (rising) -> RESET (bloqueia esta task durante a calibracao)
            else if (s2_rising && !s1) {
                triggerReset();
                clearPulses();
            }
        }

        lastS1 = s1;
        lastS2 = s2;
        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

// ============================================================
// TASK LIGHTS — cada luz com o seu proprio periodo
// ============================================================
static bool stepLight(int mode, bool current, ULONGLONG now, ULONGLONG* last) {
    switch (mode) {
    case 0: return false;
    case 1: return true;
    default: {
        ULONGLONG period = (mode == 3) ? 100 : 400;
        if (now - *last >= period) {
            *last = now;
            return !current;
        }
        return current;
    }
    }
}

void vTaskLights(void* pvParameters) {
    bool upperOn = false, lowerOn = false;
    ULONGLONG lastU = 0, lastL = 0;

    while (1) {
        ULONGLONG now = GetTickCount64();
        upperOn = stepLight(g_lightUpperMode, upperOn, now, &lastU);
        lowerOn = stepLight(g_lightLowerMode, lowerOn, now, &lastL);

        setPort2Bits(0x03, (uInt8)((upperOn ? 1 : 0) | (lowerOn ? 2 : 0)));

        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

