static bool invLock(TickType_t timeout) {
    return xSemaphoreTake(xInventoryMutex, timeout) == pdTRUE;
}
static void invUnlock() {
    xSemaphoreGive(xInventoryMutex);
}

int getFamily(int id) {
    if (id < 1 || id > 9) return 0;
    return ((id - 1) % 3) + 1;
}

// Considera pecas guardadas E reservadas (inTransit) para nao escolher a mesma celula duas vezes
int findComponentInCell(int x, int z) {
    for (int i = 1; i <= MAX_COMPONENTS; i++) {
        if ((g_inventory[i].active || g_inventory[i].inTransit) &&
            g_inventory[i].cellX == x &&
            g_inventory[i].cellZ == z)
            return i;
    }
    return -1;
}

bool findEmptyCell(int* outX, int* outZ) {
    for (int z = 1; z <= NUM_CELLS_Z; z++) {
        for (int x = 1; x <= NUM_CELLS_X; x++) {
            if (findComponentInCell(x, z) == -1) {
                *outX = x;
                *outZ = z;
                return true;
            }
        }
    }
    return false;
}

void formatTime(ULONGLONG ms, char* buf, int bufSize) {
    ULONGLONG totalSec = ms / 1000;
    ULONGLONG milli = ms % 1000;
    int h = (int)(totalSec / 3600);
    int m = (int)((totalSec / 60) % 60);
    int s = (int)(totalSec % 60);
    snprintf(buf, bufSize, "%02d:%02d:%02d.%03llu", h, m, s, milli);
}

// ============================================================
// FIFO (chamar sempre com o mutex do inventario)
// ============================================================
void fifoInsert(int id) {
    int fam = g_inventory[id].family;
    if (fam < 1 || fam > 3) return;
    if (g_fifoCount[fam] >= MAX_COMPONENTS) return;
    g_fifo[fam][g_fifoCount[fam]++] = id;
}

// Devolve a peca ao INICIO da fila (mantem a ordem FIFO original)
void fifoPushFront(int id) {
    int fam = g_inventory[id].family;
    if (fam < 1 || fam > 3) return;
    if (g_fifoCount[fam] >= MAX_COMPONENTS) return;
    for (int i = g_fifoCount[fam]; i > 0; i--)
        g_fifo[fam][i] = g_fifo[fam][i - 1];
    g_fifo[fam][0] = id;
    g_fifoCount[fam]++;
}

int fifoPop(int family) {
    if (family < 1 || family > 3) return -1;
    if (g_fifoCount[family] == 0) return -1;
    int id = g_fifo[family][0];
    for (int i = 0; i < g_fifoCount[family] - 1; i++)
        g_fifo[family][i] = g_fifo[family][i + 1];
    g_fifoCount[family]--;
    return id;
}

// Desfaz uma operacao interrompida (mutex do inventario tem de estar tomado)
static void rollbackTransitLocked(int id) {
    Component* c = &g_inventory[id];
    if (!c->inTransit) return;

    c->inTransit = false;

    if (!c->active) {
        // store interrompido: a peca nao ficou registada
        c->cellX = 0;
        c->cellZ = 0;
        c->onArm = false;
        printf("[ROLLBACK] Store ID=%d cancelado (verifica a peca manualmente)\n", id);
    }
    else if (c->onArm) {
        // dispense interrompido depois de a peca sair da celula
        c->active = false;
        c->onArm = false;
        c->cellX = 0;
        c->cellZ = 0;
        printf("[ROLLBACK] ID=%d saiu da celula e foi removido do inventario (verifica a peca)\n", id);
    }
    else {
        // dispense interrompido antes de tirar a peca: volta ao inicio da fila
        fifoPushFront(id);
        printf("[ROLLBACK] Dispense ID=%d cancelado, peca mantida na celula (%d,%d)\n",
            id, c->cellX, c->cellZ);
    }
}

// ============================================================
// Gestao das tasks (STOP/RESUME/RESET)
// ============================================================
static void suspendWorkerTasks() {
    if (hTaskOps)        vTaskSuspend(hTaskOps);
    if (hTaskGotoXZ)     vTaskSuspend(hTaskGotoXZ);
    if (hTaskVertical)   vTaskSuspend(hTaskVertical);
    if (hTaskHorizontal) vTaskSuspend(hTaskHorizontal);
}

static void resumeWorkerTasks() {
    if (hTaskOps)        vTaskResume(hTaskOps);
    if (hTaskGotoXZ)     vTaskResume(hTaskGotoXZ);
    if (hTaskVertical)   vTaskResume(hTaskVertical);
    if (hTaskHorizontal) vTaskResume(hTaskHorizontal);
}

// ============================================================
// FR2 — semiCalibration
// ============================================================
bool semiCalibration() {
    printf("[CALIB] A iniciar calibracao semi-automatica...\n");
    stopX(); stopY(); stopZ();
    bool ok = gotoY(2) && gotoX(1) && gotoZ(1);
    if (ok)
        printf("[CALIB] Concluida: X=%d Y=%d Z=%d\n", getXPos(), getYPos(), getZPos());
    else
        printf("[CALIB] FALHOU: X=%d Y=%d Z=%d\n", getXPos(), getYPos(), getZPos());
    return ok;
}

void vTaskStartupCalibration(void* pvParameters) {
    vTaskDelay(pdMS_TO_TICKS(2000));
    semiCalibration();
    vTaskDelete(NULL);
}

// ============================================================
// FR5 — STOP
// ============================================================
void triggerEmergencyStop() {
    printf("\n*** [STOP] EMERGENCY ***\n");

    g_stopped = true;
    g_lightUpperMode = 3;
    g_lightLowerMode = 3;

    // 1) suspender PRIMEIRO, 2) parar motores DEPOIS
    //    (assim nenhuma task volta a ligar um motor entre as duas coisas)
    suspendWorkerTasks();
    stopX(); stopY(); stopZ();
}

// ============================================================
// FR6 — RESUME
// ============================================================
void triggerResume() {
    printf("\n*** [RESUME] ***\n");

    bool inStore = false, inDisp = false;
    for (int i = 1; i <= MAX_COMPONENTS; i++) {
        if (g_inventory[i].inTransit) {
            if (!g_inventory[i].active) inStore = true;
            else                        inDisp = true;
            break;
        }
    }
    if (inStore) { g_lightUpperMode = 2; g_lightLowerMode = 0; }
    else if (inDisp) { g_lightUpperMode = 0; g_lightLowerMode = 2; }
    else { g_lightUpperMode = 0; g_lightLowerMode = 0; }

    g_stopped = false;
    resumeWorkerTasks();
}

// ============================================================
// FR7 — RESET
// ============================================================
void triggerReset() {
    printf("\n*** [RESET] ***\n");

    // 1. Parar motores e sinalizar abort
    stopX(); stopY(); stopZ();
    resetInProgress = true;

    // 2. Retomar as tasks para lerem a flag e abortarem (cada uma desfaz o seu inventario)
    resumeWorkerTasks();

    // 3. Esperar (ate 3 s) que todas fiquem inativas
    for (int i = 0; i < 150; i++) {
        if (!g_busyOps && !g_busyXZ && !g_busyH && !g_busyV) break;
        vTaskDelay(pdMS_TO_TICKS(20));
    }
    if (g_busyOps || g_busyXZ || g_busyH || g_busyV)
        printf("[RESET] AVISO: alguma task nao abortou a tempo\n");

    // 4. Suspender e garantir motores parados
    suspendWorkerTasks();
    stopX(); stopY(); stopZ();

    // 5. Limpar filas e semaforos
    xQueueReset(xQueueX);
    xQueueReset(xQueueZ);
    xQueueReset(mbx_XZ);
    xQueueReset(xRequestQueue);

    while (xSemaphoreTake(sem_X_finished, 0) == pdTRUE);
    while (xSemaphoreTake(sem_Z_finished, 0) == pdTRUE);
    while (xSemaphoreTake(sem_XZ_finished, 0) == pdTRUE);

    // 6. Rede de seguranca: qualquer peca ainda "em transito" e revertida
    bool locked = invLock(pdMS_TO_TICKS(2000));
    if (!locked) printf("[RESET] AVISO: inventory mutex bloqueado\n");
    for (int i = 1; i <= MAX_COMPONENTS; i++)
        rollbackTransitLocked(i);
    if (locked) invUnlock();

    g_busyH = g_busyV = g_busyXZ = g_busyOps = false;

    // 7. Flag e luzes ANTES da calibracao
    resetInProgress = false;
    g_lightUpperMode = 0;
    g_lightLowerMode = 0;

    // 8. Calibracao com as tasks suspensas (sem concorrencia)
    semiCalibration();

    // 9. Retomar
    g_stopped = false;
    resumeWorkerTasks();
}

