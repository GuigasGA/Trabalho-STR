#include "my_interaction_functions.h"

extern "C" {
#include <FreeRTOS.h>
#include <task.h>
#include <interface.h>
#include <semphr.h>
}

extern volatile bool resetInProgress;

// ============================================================
// Porta 2 (saidas) - escrita atomica
// ============================================================
static SemaphoreHandle_t xPort2Mutex = NULL;

void initMotionLayer() {
    if (xPort2Mutex == NULL)
        xPort2Mutex = xSemaphoreCreateMutex();
}

void setPort2Bits(uInt8 mask, uInt8 value) {
    // timeout curto: se uma task suspensa ficou com o mutex, o STOP nao bloqueia
    bool got = false;
    if (xPort2Mutex != NULL)
        got = (xSemaphoreTake(xPort2Mutex, pdMS_TO_TICKS(50)) == pdTRUE);

    uInt8 p = readDigitalU8(2);
    p = (uInt8)((p & (uInt8)~mask) | (value & mask));
    writeDigitalU8(2, p);

    if (got) xSemaphoreGive(xPort2Mutex);
}

// ============================================================
// Bit manipulation
// ============================================================
int getBitValue(uInt8 value, uInt8 bit_n) {
    return(value & (1 << bit_n));
}

void setBitValue(uInt8* variable, int n_bit, int new_value_bit) {
    uInt8 mask_on = (uInt8)(1 << n_bit);
    uInt8 mask_off = ~mask_on;
    if (new_value_bit) *variable |= mask_on;
    else *variable &= mask_off;
}

static bool moveTimedOut(ULONGLONG start, ULONGLONG maxMs, const char* fn) {
    if (GetTickCount64() - start > maxMs) {
        printf("[%s] TIMEOUT\n", fn);
        return true;
    }
    return false;
}

// Ordem FISICA do Z (confirmar no kit): 1 < 4 < 2 < 5 < 3 < 6
// Se for outra, basta alterar esta tabela.
static int zRank(int pos) {
    static const int r[7] = { -1, 0, 2, 4, 1, 3, 5 };
    if (pos < 1 || pos > 6) return -1;
    return r[pos];
}

// ============================================================
// X axis   (limites: posicao 1 = esquerda, posicao 3 = direita)
// ============================================================
void moveXLeft() {
    if (getXPos() == 1) { stopX(); return; }
    setPort2Bits(0xC0, (uInt8)(1 << 6));
}
void moveXRight() {
    if (getXPos() == 3) { stopX(); return; }
    setPort2Bits(0xC0, (uInt8)(1 << 7));
}
void stopX() { setPort2Bits(0xC0, 0); }

int getXPos() {
    uInt8 p = readDigitalU8(0);
    if (!getBitValue(p, 2)) return 1;
    if (!getBitValue(p, 1)) return 2;
    if (!getBitValue(p, 0)) return 3;
    return -1;
}

void gotoX(int x) {
    if (x < 1 || x > 3) return;

    // se perdido (-1), vai para a posicao 1 primeiro (referencia)
    if (getXPos() == -1) {
        printf("[gotoX] posicao desconhecida, homing para X=1\n");
        ULONGLONG h = GetTickCount64();
        while (getXPos() != 1) {
            if (resetInProgress) { stopX(); return; }
            if (moveTimedOut(h, 5000, "gotoX-homing")) { stopX(); return; }
            moveXLeft(); vTaskDelay(1);
        }
        stopX();
    }

    int currentPos = getXPos();
    ULONGLONG start = GetTickCount64();

    if (x == 1) {
        while (getXPos() != 1) {
            if (resetInProgress) { stopX(); return; }
            if (moveTimedOut(start, 15000, "gotoX")) { stopX(); return; }
            moveXLeft(); vTaskDelay(1);
        }
        stopX();
    }
    else if (x == 2) {
        if (currentPos < 2) {
            while (getXPos() != 2) {
                if (resetInProgress) { stopX(); return; }
                if (getXPos() == 3) { stopX(); printf("[gotoX] LIMITE direito\n"); return; }
                if (moveTimedOut(start, 15000, "gotoX")) { stopX(); return; }
                moveXRight(); vTaskDelay(1);
            }
        }
        else {
            while (getXPos() != 2) {
                if (resetInProgress) { stopX(); return; }
                if (getXPos() == 1) { stopX(); printf("[gotoX] LIMITE esquerdo\n"); return; }
                if (moveTimedOut(start, 15000, "gotoX")) { stopX(); return; }
                moveXLeft(); vTaskDelay(1);
            }
        }
        stopX();
    }
    else if (x == 3) {
        while (getXPos() != 3) {
            if (resetInProgress) { stopX(); return; }
            if (moveTimedOut(start, 15000, "gotoX")) { stopX(); return; }
            moveXRight(); vTaskDelay(1);
        }
        stopX();
    }
}

// ============================================================
// Y axis   (limites: posicao 1 = fora, posicao 3 = dentro)
// ============================================================
void moveYInside() {
    if (getYPos() == 3) { stopY(); return; }
    setPort2Bits(0x30, (uInt8)(1 << 5));
}
void moveYOutside() {
    if (getYPos() == 1) { stopY(); return; }
    setPort2Bits(0x30, (uInt8)(1 << 4));
}
void stopY() { setPort2Bits(0x30, 0); }

int getYPos() {
    uInt8 p = readDigitalU8(0);
    if (!getBitValue(p, 5)) return 1;
    if (!getBitValue(p, 4)) return 2;
    if (!getBitValue(p, 3)) return 3;
    return -1;
}

void gotoY(int y) {
    if (y < 1 || y > 3) return;

    if (getYPos() == -1) {
        printf("[gotoY] posicao desconhecida, homing para Y=1\n");
        ULONGLONG h = GetTickCount64();
        while (getYPos() != 1) {
            if (resetInProgress) { stopY(); return; }
            if (moveTimedOut(h, 5000, "gotoY-homing")) { stopY(); return; }
            moveYOutside(); vTaskDelay(1);
        }
        stopY();
    }

    int currentPos = getYPos();
    ULONGLONG start = GetTickCount64();

    if (y == 1) {
        while (getYPos() != 1) {
            if (resetInProgress) { stopY(); return; }
            if (moveTimedOut(start, 15000, "gotoY")) { stopY(); return; }
            moveYOutside(); vTaskDelay(1);
        }
        stopY();
    }
    else if (y == 2) {
        if (currentPos < 2) {
            while (getYPos() != 2) {
                if (resetInProgress) { stopY(); return; }
                if (getYPos() == 3) { stopY(); printf("[gotoY] LIMITE interior\n"); return; }
                if (moveTimedOut(start, 15000, "gotoY")) { stopY(); return; }
                moveYInside(); vTaskDelay(1);
            }
        }
        else {
            while (getYPos() != 2) {
                if (resetInProgress) { stopY(); return; }
                if (getYPos() == 1) { stopY(); printf("[gotoY] LIMITE exterior\n"); return; }
                if (moveTimedOut(start, 15000, "gotoY")) { stopY(); return; }
                moveYOutside(); vTaskDelay(1);
            }
        }
        stopY();
    }
    else if (y == 3) {
        while (getYPos() != 3) {
            if (resetInProgress) { stopY(); return; }
            if (moveTimedOut(start, 15000, "gotoY")) { stopY(); return; }
            moveYInside(); vTaskDelay(1);
        }
        stopY();
    }
}

// ============================================================
// Z axis   (limites: posicao 1 = em baixo, posicao 6 = em cima)
// ============================================================
void moveZUp() {
    if (getZPos() == 6) { stopZ(); return; }
    setPort2Bits(0x0C, (uInt8)(1 << 3));
}
void moveZDown() {
    if (getZPos() == 1) { stopZ(); return; }
    setPort2Bits(0x0C, (uInt8)(1 << 2));
}
void stopZ() { setPort2Bits(0x0C, 0); }

int getZPos() {
    uInt8 p0 = readDigitalU8(0);
    uInt8 p1 = readDigitalU8(1);
    if (!getBitValue(p1, 3)) return 1;
    if (!getBitValue(p1, 1)) return 2;
    if (!getBitValue(p0, 7)) return 3;
    if (!getBitValue(p1, 2)) return 4;
    if (!getBitValue(p1, 0)) return 5;
    if (!getBitValue(p0, 6)) return 6;
    return -1;
}

void gotoZ(int z) {
    if (z < 1 || z > 3) return;

    if (getZPos() == -1) {
        printf("[gotoZ] posicao desconhecida, homing para Z=1\n");
        ULONGLONG h = GetTickCount64();
        while (getZPos() != 1) {
            if (resetInProgress) { stopZ(); return; }
            if (moveTimedOut(h, 5000, "gotoZ-homing")) { stopZ(); return; }
            moveZDown(); vTaskDelay(1);
        }
        stopZ();
    }

    int currentPos = getZPos();
    ULONGLONG start = GetTickCount64();

    if (z == 1) {
        while (getZPos() != 1) {
            if (resetInProgress) { stopZ(); return; }
            if (moveTimedOut(start, 15000, "gotoZ")) { stopZ(); return; }
            moveZDown(); vTaskDelay(1);
        }
        stopZ();
    }
    else if (z == 2) {
        if (zRank(currentPos) < zRank(2)) {
            while (getZPos() != 2) {
                if (resetInProgress) { stopZ(); return; }
                if (getZPos() == 6) { stopZ(); printf("[gotoZ] LIMITE superior\n"); return; }
                if (moveTimedOut(start, 15000, "gotoZ")) { stopZ(); return; }
                moveZUp(); vTaskDelay(1);
            }
        }
        else {
            while (getZPos() != 2) {
                if (resetInProgress) { stopZ(); return; }
                if (getZPos() == 1) { stopZ(); printf("[gotoZ] LIMITE inferior\n"); return; }
                if (moveTimedOut(start, 15000, "gotoZ")) { stopZ(); return; }
                moveZDown(); vTaskDelay(1);
            }
        }
        stopZ();
    }
    else if (z == 3) {
        if (zRank(currentPos) < zRank(3)) {
            while (getZPos() != 3) {
                if (resetInProgress) { stopZ(); return; }
                if (getZPos() == 6) { stopZ(); printf("[gotoZ] LIMITE superior\n"); return; }
                if (moveTimedOut(start, 15000, "gotoZ")) { stopZ(); return; }
                moveZUp(); vTaskDelay(1);
            }
        }
        else {
            while (getZPos() != 3) {
                if (resetInProgress) { stopZ(); return; }
                if (getZPos() == 1) { stopZ(); printf("[gotoZ] LIMITE inferior\n"); return; }
                if (moveTimedOut(start, 15000, "gotoZ")) { stopZ(); return; }
                moveZDown(); vTaskDelay(1);
            }
        }
        stopZ();
    }
}

void gotoZUp() {
    int currentPos = getZPos();
    if (currentPos == -1) {
        ULONGLONG h = GetTickCount64();
        while (getZPos() != 1) {
            if (resetInProgress) { stopZ(); return; }
            if (moveTimedOut(h, 5000, "gotoZUp-homing")) { stopZ(); return; }
            moveZDown(); vTaskDelay(1);
        }
        stopZ();
        currentPos = 1;
    }

    int target = -1;
    if (currentPos == 1) target = 4;
    else if (currentPos == 2) target = 5;
    else if (currentPos == 3) target = 6;
    if (target == -1) return;

    ULONGLONG start = GetTickCount64();
    while (getZPos() != target) {
        if (resetInProgress) { stopZ(); return; }
        if (getZPos() == 6) { stopZ(); printf("[gotoZUp] LIMITE superior\n"); return; }
        if (moveTimedOut(start, 15000, "gotoZUp")) { stopZ(); return; }
        moveZUp(); vTaskDelay(1);
    }
    stopZ();
}

void gotoZDown() {
    int currentPos = getZPos();
    if (currentPos == -1) {
        ULONGLONG h = GetTickCount64();
        while (getZPos() != 1) {
            if (resetInProgress) { stopZ(); return; }
            if (moveTimedOut(h, 5000, "gotoZDown-homing")) { stopZ(); return; }
            moveZDown(); vTaskDelay(1);
        }
        stopZ();
        currentPos = 1;
    }

    int target = -1;
    if (currentPos == 4) target = 1;
    else if (currentPos == 5) target = 2;
    else if (currentPos == 6) target = 3;
    if (target == -1) return;

    ULONGLONG start = GetTickCount64();
    while (getZPos() != target) {
        if (resetInProgress) { stopZ(); return; }
        if (getZPos() == 1) { stopZ(); printf("[gotoZDown] LIMITE inferior\n"); return; }
        if (moveTimedOut(start, 15000, "gotoZDown")) { stopZ(); return; }
        moveZDown(); vTaskDelay(1);
    }
    stopZ();
}

void putPartInCell() {
    gotoZUp();
    gotoY(3);
    gotoZDown();
    gotoY(2);
}

void takePartFromCell() {
    gotoY(3);
    gotoZUp();
    gotoY(2);
    gotoZDown();
}

// ============================================================
// Guarda de limites (chamada periodicamente por uma task)
// Cobre os movimentos manuais continuos (a/d/q/e/w/x)
// ============================================================
void enforceAxisLimits() {
    uInt8 p = readDigitalU8(2);
    int x = getXPos();
    int y = getYPos();
    int z = getZPos();

    if (x == 3 && (p & (1 << 7))) stopX();
    if (x == 1 && (p & (1 << 6))) stopX();
    if (y == 3 && (p & (1 << 5))) stopY();
    if (y == 1 && (p & (1 << 4))) stopY();
    if (z == 6 && (p & (1 << 3))) stopZ();
    if (z == 1 && (p & (1 << 2))) stopZ();
}
