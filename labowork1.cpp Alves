    printf("ASSERT! Line %ld, file %s\r\n", ulLine, pcFileName);
    taskENTER_CRITICAL();
    while (1);
}

static void initialiseHeap(void) {
    static uint8_t ucHeap[configTOTAL_HEAP_SIZE];
    volatile uint32_t ulAdditionalOffset = 19;
    const HeapRegion_t xHeapRegions[] = {
        { ucHeap + 1,                                              mainREGION_1_SIZE },
        { ucHeap + 15 + mainREGION_1_SIZE,                          mainREGION_2_SIZE },
        { ucHeap + 19 + mainREGION_1_SIZE + mainREGION_2_SIZE,      mainREGION_3_SIZE },
        { NULL, 0 }
    };
    vPortDefineHeapRegions(xHeapRegions);
}

// ============================================================
// ISRs DOS BOTÕES 
// Têm de estar definidas ANTES de serem usadas no attachInterrupt
// ============================================================
void switch1_rising_isr(ULONGLONG lastTime) {
    ULONGLONG time = GetTickCount64();
    printf("\nSwitch one RISING detected at time = %llu...\n", time);

    g_pulseUpper++;
    g_lastUpperTime = time;
}

void switch1_falling_isr(ULONGLONG lastTime) {
    ULONGLONG time = GetTickCount64();
    printf("\nSwitch one FALLING detected at time = %llu...\n", time);
}

void switch2_rising_isr(ULONGLONG lastTime) {
    ULONGLONG time = GetTickCount64();
    printf("\nSwitch two RISING detected at time = %llu...\n", time);

    g_pulseLower++;
    g_lastLowerTime = time;
}

// ============================================================
// TASKS de emergência/resume 
// NÃO são criadas ainda — dependem de taskSender
// ============================================================
void vTaskEmergency(void* pvParameters) {
    for (;;) {
        vTaskSuspend(NULL);
        printf("\n **** EMERGENCY task\n");
        vTaskSuspend(taskSender);
    }
}

void vTaskResume(void* pvParameters) {
    for (;;) {
        vTaskSuspend(NULL);
        printf("\n **** RESUME task\n");
        vTaskResume(taskSender);
    }
}

// ============================================================
// TASK MENU
// ============================================================
void vTaskMenu(void* pvParameters) {
    int tecla = 0;
    while (tecla != 27) {
        if (_kbhit()) {
            tecla = _getch();

            if (tecla == 's') { stopX(); stopY(); stopZ(); }
            if (tecla == 'q') { printf("Y dentro\n");  moveYInside(); }
            if (tecla == 'e') { printf("Y fora\n");    moveYOutside(); }
            if (tecla == 'w') { printf("Z cima\n");    moveZUp(); }
            if (tecla == 'x') { printf("Z baixo\n");   moveZDown(); }
            if (tecla == 'a') { printf("X esquerda\n"); moveXLeft(); }
            if (tecla == 'd') { printf("X direita\n"); moveXRight(); }

            if (tecla == '1') { int v = 1; xQueueSend(xQueueX, &v, 0); printf("pedido X=1\n"); }
            if (tecla == '2') { int v = 2; xQueueSend(xQueueX, &v, 0); printf("pedido X=2\n"); }
            if (tecla == '3') { int v = 3; xQueueSend(xQueueX, &v, 0); printf("pedido X=3\n"); }

            if (tecla == '7') { int v = 1; xQueueSend(xQueueZ, &v, 0); printf("pedido Z=1\n"); }
            if (tecla == '8') { int v = 2; xQueueSend(xQueueZ, &v, 0); printf("pedido Z=2\n"); }
            if (tecla == '9') { int v = 3; xQueueSend(xQueueZ, &v, 0); printf("pedido Z=3\n"); }

            if (tecla == '4') { printf("gotoY(1)\n"); gotoY(1); }
            if (tecla == '5') { printf("gotoY(2)\n"); gotoY(2); }
            if (tecla == '6') { printf("gotoY(3)\n"); gotoY(3); }

            if (tecla == 'u') { printf("gotoZUp\n");   gotoZUp(); }
            if (tecla == 'z') { printf("gotoZDown\n"); gotoZDown(); }
            if (tecla == 'p') { printf("putPartInCell\n");   putPartInCell(); }
            if (tecla == 't') { printf("takePartFromCell\n"); takePartFromCell(); }

            if (tecla == 'l') {
                g_lightUpperMode = (g_lightUpperMode + 1) % 4;
                printf("Luz upper mode = %d\n", g_lightUpperMode);
            }
            if (tecla == 'k') {
                g_lightLowerMode = (g_lightLowerMode + 1) % 4;
                printf("Luz lower mode = %d\n", g_lightLowerMode);
            }
            // --- Comando de teste: pedir (x,z) e enviar para a mediation task ---
            if (tecla == 'g') {
                printf("X (1-3): ");
                int x = 0;
                while (!_kbhit()) vTaskDelay(pdMS_TO_TICKS(20));
                x = _getch() - '0';
                printf("%d\n", x);

                printf("Z (1-3): ");
                int z = 0;
                while (!_kbhit()) vTaskDelay(pdMS_TO_TICKS(20));
                z = _getch() - '0';
                printf("%d\n", z);

                if (x >= 1 && x <= 3 && z >= 1 && z <= 3) {
                    Coords c = { x, z };
                    xQueueSend(mbx_XZ, &c, 0);
                }
                else {
                    printf("Coordenadas invalidas\n");
                }
            }
        }
        vTaskDelay(pdMS_TO_TICKS(20));
    }
    closeChannels();
    exit(0);
}

// ============================================================
// TASK HORIZONTAL — controla o eixo X
// ============================================================
void vTaskHorizontal(void* pvParameters) {
    int target;
    while (1) {
        if (xQueueReceive(xQueueX, &target, portMAX_DELAY) == pdTRUE) {
            if (getYPos() != 2) {
                printf("[H] Y nao esta em 2, ignorado X=%d\n", target);
                xSemaphoreGive(sem_X_finished);
                continue;
            }
            printf("[H] gotoX(%d)\n", target);
            gotoX(target);
            xSemaphoreGive(sem_X_finished);
        }
    }
}

// ============================================================
// TASK VERTICAL — controla o eixo Z
// ============================================================
void vTaskVertical(void* pvParameters) {
    int target;
    while (1) {
        if (xQueueReceive(xQueueZ, &target, portMAX_DELAY) == pdTRUE) {
            if (getYPos() != 2) {
                printf("[V] Y nao esta em 2, ignorado Z=%d\n", target);
                xSemaphoreGive(sem_Z_finished);
                continue;
            }
            printf("[V] gotoZ(%d)\n", target);
            gotoZ(target);
            xSemaphoreGive(sem_Z_finished);
        }
    }
}

// ============================================================
// TASK GOTO_XZ — mediation task
// Recebe (x,z) por mailbox, despacha para xQueueX/xQueueZ em paralelo,
// espera que ambos terminem.
// ============================================================
void goto_XZ_task(void* pvParameters) {
    Coords c;
    while (TRUE) {
        if (xQueueReceive(mbx_XZ, &c, portMAX_DELAY) == pdTRUE) {
            printf("[XZ] goto (%d,%d)\n", c.x, c.z);

            xQueueSend(xQueueX, &c.x, portMAX_DELAY);
            xQueueSend(xQueueZ, &c.z, portMAX_DELAY);

            xSemaphoreTake(sem_X_finished, portMAX_DELAY);
            xSemaphoreTake(sem_Z_finished, portMAX_DELAY);

            printf("[XZ] done (%d,%d)\n", c.x, c.z);
        }
    }
}

// ============================================================
// TASK BUTTON REPORTER — timeout da sequência de pulsos
// ============================================================
void vTaskButtonReporter(void* pvParameters) {
    while (1) {
        ULONGLONG now = GetTickCount64();

        if (g_pulseUpper > 0 && (now - g_lastUpperTime) > PULSE_TIMEOUT_MS) {
            int id = g_pulseUpper;
            g_pulseUpper = 0;
            printf("[BTN] Upper sequence complete: ID=%d\n", id);
            // TODO (Fase 4.4): enviar REQ_STORE(id)
        }

        if (g_pulseLower > 0 && (now - g_lastLowerTime) > PULSE_TIMEOUT_MS) {
            int fam = g_pulseLower;
            g_pulseLower = 0;
            printf("[BTN] Lower sequence complete: family=%d\n", fam);
            // TODO (Fase 4.5): enviar REQ_DISPENSE(fam)
        }

        uInt8 p1 = readDigitalU8(1);
        bool s1 = getBitValue(p1, 5) ? true : false;
        bool s2 = getBitValue(p1, 6) ? true : false;
        g_bothPressed = (s1 && s2);

        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

// ============================================================
// TASK LIGHTS
// ============================================================
void vTaskLights(void* pvParameters) {
    bool upperOn = false;
    bool lowerOn = false;
    ULONGLONG lastToggle = 0;

    while (1) {
        ULONGLONG now = GetTickCount64();
        ULONGLONG elapsed = now - lastToggle;

        bool tick = false;
        ULONGLONG period = 1000;

        if (g_lightUpperMode == 3 || g_lightLowerMode == 3) {
            period = 100;
        }
        else if (g_lightUpperMode == 2 || g_lightLowerMode == 2) {
            period = 400;
        }

        if (elapsed >= period) {
            tick = true;
            lastToggle = now;
        }

        switch (g_lightUpperMode) {
        case 0: upperOn = false; break;
        case 1: upperOn = true;  break;
        case 2:
        case 3: if (tick) upperOn = !upperOn; break;
        }

        switch (g_lightLowerMode) {
        case 0: lowerOn = false; break;
        case 1: lowerOn = true;  break;
        case 2:
        case 3: if (tick) lowerOn = !lowerOn; break;
        }

        uInt8 p = readDigitalU8(2);
        setBitValue(&p, 0, upperOn ? 1 : 0);
        setBitValue(&p, 1, lowerOn ? 1 : 0);
        writeDigitalU8(2, p);

        vTaskDelay(pdMS_TO_TICKS(20));
    }
}

// ============================================================
// HOOK DE ARRANQUE
// ============================================================
void myDaemonTaskStartupHook(void) {
    createDigitalInput(0);
    createDigitalInput(1);
    createDigitalOutput(2);

    printf("\nCalibra o kit manualmente e prime ENTER...");
    while (true) {
        if (_kbhit() && _getch() == 13) break;
    }
    printf("\nA iniciar tarefas...\n");

    // Filas de movimento
    xQueueX = xQueueCreate(5, sizeof(int));
    xQueueZ = xQueueCreate(5, sizeof(int));
    mbx_XZ = xQueueCreate(5, sizeof(Coords));
    

    // Semáforos de conclusão de movimento
    sem_X_finished = xSemaphoreCreateCounting(10, 0);
    sem_Z_finished = xSemaphoreCreateCounting(10, 0);

    // Criar tarefas
    xTaskCreate(vTaskMenu, "Menu", 1000, NULL, 2, NULL);
    xTaskCreate(vTaskHorizontal, "Horizontal", 1000, NULL, 2, NULL);
    xTaskCreate(vTaskVertical, "Vertical", 1000, NULL, 2, NULL);
    xTaskCreate(vTaskButtonReporter, "BtnReporter", 1000, NULL, 2, NULL);
    xTaskCreate(vTaskLights, "Lights", 500, NULL, 1, NULL);
    xTaskCreate(goto_XZ_task, "GOTO XZ Task", 1000, NULL, 3, NULL);

    //xTaskCreate(vTaskEmergency, "Emergency", 500, NULL, 2, &emergencyTask);
    //xTaskCreate(vTaskResume,    "Resume",    500, NULL, 2, &resumeTask);

    // Anexar ISRs aos pinos dos botões
    attachInterrupt(1, 5, switch1_rising_isr, RISING);
    attachInterrupt(1, 5, switch1_falling_isr, FALLING);
    attachInterrupt(1, 6, switch2_rising_isr, RISING);
}

// ============================================================
// MAIN
// ============================================================
int main() {
    initialiseHeap();
    vApplicationDaemonTaskStartupHook = &myDaemonTaskStartupHook;
    vTaskStartScheduler();

    while (1);
    return 0;
}
