// ============================================================
// HANDLES GLOBAIS
// ============================================================
xQueueHandle xQueueX = NULL;
xQueueHandle xQueueZ = NULL;

SemaphoreHandle_t sem_X_finished = NULL;
SemaphoreHandle_t sem_Z_finished = NULL;

// (Reservados para a Fase 4.6 — STOP/RESET)
xTaskHandle emergencyTask = NULL;
xTaskHandle resumeTask = NULL;
xTaskHandle taskSender = NULL;

// Mailbox e semáforo para a mediation task
typedef struct {
    int x;
    int z;
} Coords;

QueueHandle_t     mbx_XZ = NULL;

// ============================================================
// ESTADO DOS BOTÕES E LUZES
// ============================================================
volatile int       g_pulseUpper = 0;
volatile int       g_pulseLower = 0;
volatile ULONGLONG g_lastUpperTime = 0;
volatile ULONGLONG g_lastLowerTime = 0;
volatile bool      g_bothPressed = false;

// Modos de luz: 0=OFF, 1=ON, 2=FLASH_SLOW, 3=FLASH_FAST
volatile int g_lightUpperMode = 0;
volatile int g_lightLowerMode = 0;

// ============================================================
// OBRIGATÓRIO para o FreeRTOS
// ============================================================
extern "C"
